# ──────────────────────────────────────────────
# Environment Variables Template for RAG Chatbot
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to Git!
# ──────────────────────────────────────────────

# ── Groq API (Required) ──────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_actual_api_key_here

# ── LLM Settings (Optional) ──────────────────
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.7
TOP_P=1.0
MAX_TOKENS=1024

# ── Embedding Settings (Optional) ────────────
# Local model from sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking Settings (Optional) ─────────────
# Size of each text chunk (in characters)
CHUNK_SIZE=500
# Overlap between consecutive chunks
CHUNK_OVERLAP=50

# ── Retrieval Settings (Optional) ────────────
# Number of top similar chunks to retrieve
TOP_K_RESULTS=5

# ── Conversation History (Optional) ──────────
# Max message pairs per session (user+assistant)
MAX_HISTORY_LENGTH=50

# ── Vector Database (Optional) ───────────────
# Directory for ChromaDB persistence
CHROMA_PERSIST_DIR=data/chroma
