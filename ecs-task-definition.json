{
  "family": "rag-chatbot-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::854439545207:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "rag-chatbot",
      "memory": 1024,
      "memoryReservation": 512,
      "image": "854439545207.dkr.ecr.ap-south-1.amazonaws.com/rag-chatbot:1.3",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MODEL_NAME",
          "value": "openai/gpt-oss-120b"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rag-chatbot-task",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:854439545207:secret:rag-chatbot/database-url-iECcda"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:854439545207:secret:rag-chatbot/groq-api-key-eQhozw"
        }
      ]
    }
  ]
}